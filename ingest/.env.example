# Copy to .env and adjust if needed.
# Homebrew Postgres on macOS uses your macOS username with no password by default.
DATABASE_URL=postgresql://abhisheshpradhan@localhost:5432/kindello

# Webshare proxies — used to fetch WAF-blocked open-data sources (ACECQA national registers).
# Provide EITHER a list of proxies OR a Webshare proxy-list download URL.
#
# Option A: explicit proxies, one per line or comma-separated.
#   Accepts "http://user:pass@host:port" OR Webshare's "host:port:user:pass" line format.
WEBSHARE_PROXIES=

#
# Option B: Webshare "Proxy List -> Download" URL (returns host:port:user:pass lines).
# WEBSHARE_LIST_URL=https://proxy.webshare.io/api/v2/proxy/list/download/<token>/-/any/username/direct/-/
