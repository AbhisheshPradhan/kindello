# Kindello web app — environment template. Copy to .env.local and fill in.
# Next.js reads .env.local (git-ignored); this .env.example is the committed, credential-free template.

# Local Postgres (the chatbot's read connection). No password locally (trust auth).
DATABASE_URL=postgresql://USER@localhost:5432/kindello

# LLM provider API keys — fill the ones you want to test in the model dropdown.
# You only need a key for the providers you actually select.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
