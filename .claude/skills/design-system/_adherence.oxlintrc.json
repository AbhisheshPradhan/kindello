{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chat/**",
              "components/core/**",
              "components/directory/**",
              "ui_kits/kindello-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Geist|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Geist, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|full|iconLeft|iconRight|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, full, iconLeft, iconRight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|count|tone|key|ref|className|style|children)$/]",
        "message": "<CategoryTile> doesn't accept that prop. Declared props: icon, label, count, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|coral|sun)$/]",
        "message": "<CategoryTile> tone must be one of 'teal' | 'coral' | 'sun'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CentreCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|centreName|suburb|distance|rating|reviews|nqs|tags|keyInfo|verified|seed|featured|style|key|ref|className|style|children)$/]",
        "message": "<CentreCard> doesn't accept that prop. Declared props: name, centreName, suburb, distance, rating, reviews, nqs, tags, keyInfo, verified, seed, featured, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|model|onChange|onSubmit|size|style|key|ref|className|style|children)$/]",
        "message": "<ChatComposer> doesn't accept that prop. Declared props: placeholder, value, model, onChange, onSubmit, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatComposer'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<ChatComposer> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContinueSearchCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:query|summary|when|pins|onResume|style|key|ref|className|style|children)$/]",
        "message": "<ContinueSearchCard> doesn't accept that prop. Declared props: query, summary, when, pins, onResume, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConversationTabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|placesCount|onSelect|onNewSearch|sticky|top|style|key|ref|className|style|children)$/]",
        "message": "<ConversationTabs> doesn't accept that prop. Declared props: active, placesCount, onSelect, onNewSearch, sticky, top, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConversationTabs'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:answer|places)$/]",
        "message": "<ConversationTabs> active must be one of 'answer' | 'places'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FollowUps'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<FollowUps> doesn't accept that prop. Declared props: title, items, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuideCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|category|readTime|seed|key|ref|className|style|children)$/]",
        "message": "<GuideCard> doesn't accept that prop. Declared props: title, category, readTime, seed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:star|map-pin|clock|users|phone|heart|shield-check|sparkles|search|arrow-up|chevron-right|chevron-down|check|baby|graduation-cap|blocks|sun)$/]",
        "message": "<Icon> name must be one of 'star' | 'map-pin' | 'clock' | 'users' | 'phone' | 'heart' | 'shield-check' | 'sparkles' | 'search' | 'arrow-up' | 'chevron-right' | 'chevron-down' | 'check' | 'baby' | 'graduation-cap' | 'blocks' | 'sun'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaceResultCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|suburb|distance|rating|reviews|placesNow|phone|verified|seed|onMore|style|key|ref|className|style|children)$/]",
        "message": "<PlaceResultCard> doesn't accept that prop. Declared props: name, suburb, distance, rating, reviews, placesNow, phone, verified, seed, onMore, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:rating|key|ref|className|style|children)$/]",
        "message": "<RatingBadge> doesn't accept that prop. Declared props: rating."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatingBadge'] > JSXAttribute[name.name='rating'] > Literal[value!=/^(?:Excellent|Exceeding NQS|Meeting NQS|Working Towards NQS|Significant Improvement Required)$/]",
        "message": "<RatingBadge> rating must be one of 'Excellent' | 'Exceeding NQS' | 'Meeting NQS' | 'Working Towards NQS' | 'Significant Improvement Required'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|count|size|showValue|style|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: value, count, size, showValue, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|teal|coral|sun)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'teal' | 'coral' | 'sun'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UserBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<UserBubble> doesn't accept that prop. Declared props: children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
